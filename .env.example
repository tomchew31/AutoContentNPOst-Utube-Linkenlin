# Anthropic (research + script generation)
ANTHROPIC_API_KEY=

# HeyGen (avatar video rendering)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# If true, SKIPS HeyGen entirely and uses a placeholder video instead —
# zero HeyGen cost, useful for testing captions/upload. Set false for real runs.
HEYGEN_TEST_MODE=false

# YouTube (upload) - see README for how to obtain these via Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PUBLISH_STATUS=private

# LinkedIn (optional - text post only, no video upload in this version)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Set true to generate script + LinkedIn post only, skip render/upload (fast, cheap way to test)
DRY_RUN=false
